# Server
PORT=8787
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://localhost:5432/glance

# Solana
SOLANA_CLUSTER=devnet                      # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC (Circle). Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Vault program + keys (see setup-devnet.ts). The agent key is the hot delegated signer; keep it out of git.
VAULT_PROGRAM_ID=DP7QYPQZh2XqMREGWQ5MNo1vgGUSZbfAzJu3uRQATnmy
AGENT_KEYPAIR=./.keys/agent.json
DESK_KEYPAIR=./.keys/desk.json
SESSION_SECRET=                            # long random string; signs session JWTs
WEB_CONSOLE_URL=http://localhost:5173      # Phantom-facing console (glance-web)
ALLOWED_ORIGINS=                           # CORS allow-list, comma-separated. Empty = any origin (dev only). Production: chrome-extension://<id>,https://<console>

# Jupiter (keyless = 0.5 rps; get a key at developers.jup.ag/portal for 1+ rps)
JUPITER_API_URL=https://api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
JUPITER_API_KEY=
JUPITER_PROGRAM_ID=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4

# Prices. Pyth Hermes/Benchmarks need a bearer key since 2026-08-26 (pythdata.app/signup, trial available).
# Without a key PRICE_SOURCE=auto falls back to Jupiter Price v3 (24/7 on-chain token price, keyless).
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network
PYTH_API_KEY=
PRICE_SOURCE=auto                          # auto | pyth | jupiter

# Guards
PRICE_MAX_DEVIATION_BPS=100                # quote must be within 1% of Pyth (spec §8.3 guard 6)
PRICE_MAX_AGE_SEC=300                      # Pyth publish_time older than this counts as stale
PRICE_STALE_POLICY=widen                   # reject | widen  (widen = allow PRICE_STALE_DEVIATION_BPS when feed is stale, e.g. off-hours)
PRICE_STALE_DEVIATION_BPS=300
FEE_TOLERANCE_BPS=100                      # max value a non-user wallet-owned account may gain, as bps of amount_in (guard 4 "expected fees")
MAX_USER_LAMPORTS_SPEND=15000000           # 0.015 SOL: tx fee + priority fee + up to ~3 ATA rents
ISSUER_MODE=mock                           # mock | registry   (mock = trust the issuer list in src/config/issuers.mock.json for devnet)

# Devnet mock route (set by setup-devnet.ts)
ROUTE_PROVIDER=                            # jupiter | desk   (default: desk on devnet, jupiter on mainnet)
DESK_SPREAD_BPS=30
PAYER_KEYPAIR=~/.config/solana/id.json     # devnet payer: funds test money, deploys, runs scripts as the owner

# Defaults for new sessions (USD)
DEFAULT_DAILY_CAP_USD=20
DEFAULT_PER_TX_CAP_USD=20
DEFAULT_MAX_SLIPPAGE_BPS=100
SESSION_TTL_DAYS=7

# LLM + news
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5            # default model; "show me" and the vision fallback use it unless LLM_VISION_MODEL is set
LLM_VISION_MODEL=                 # optional: model for "show me" (POST /explain); defaults to LLM_MODEL
LLM_READ_MODEL=claude-haiku-4-5   # model for the screenshot fallback (POST /glance/vision): transcription only, no drawing
LLM_FAST_MODEL=claude-haiku-4-5   # model for disambiguation, "why", counter-view and voice commands the grammar missed
LLM_VISION_EFFORT=low             # effort for "show me" (low | medium | high); medium measured twice the output for no visible gain
LLM_VISION_THINKING=on            # on | off for "show me"; off measured -17% output tokens (~0.13¢ a call) on one capture; replay more before turning off
EVAL_CAPTURE_DIR=                 # dev only: e.g. ./eval-captures saves each "show me" request, screenshot included, for replay on other models; leave empty otherwise
NEWS_API_KEY=                     # Finnhub token (finnhub.io); powers POST /why. Empty → "I can't check the news right now."

# Voice (spec §7.1): Fish Audio text-to-speech for the bubble. Empty → the browser's local voice.
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=536d3a5e000945adb7038665781a4aca   # "Ethan" by Fish Official
FISH_AUDIO_MODEL=s1
